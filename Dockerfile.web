FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt requirements-db.txt requirements-risk.txt ./
RUN pip install --no-cache-dir -r requirements-db.txt -r requirements-risk.txt
COPY . .
CMD ["sh", "-c", "alembic upgrade head && python -u web_app.py"]
