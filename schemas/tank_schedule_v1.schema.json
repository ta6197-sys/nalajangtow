{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docktimize isolated tank schedule V1",
  "description": "Requires timezone-aware times. Numeric/time conservation is checked by validator.py; no berth assignment is performed here.",
  "type": "object",
  "required": [
    "schema_version",
    "horizon_start_at",
    "horizon_end_at",
    "calls",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": "TANK_SCHEDULE_V1"
    },
    "horizon_start_at": {
      "type": "string",
      "format": "date-time"
    },
    "horizon_end_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "call_id",
          "cargo_type",
          "direction",
          "berth_id",
          "tank_id",
          "cargo_volume_bbl"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "minLength": 1
          },
          "cargo_type": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "DISCHARGE",
              "LOAD"
            ]
          },
          "berth_id": {
            "type": "string",
            "minLength": 1
          },
          "tank_id": {
            "type": "string",
            "minLength": 1
          },
          "cargo_volume_bbl": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "cargo_mass_kg": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "density_kg_per_bbl": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "call_id",
          "start_at",
          "end_at",
          "rate_bbl_per_hour"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "minLength": 1
          },
          "start_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_at": {
            "type": "string",
            "format": "date-time"
          },
          "rate_bbl_per_hour": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          }
        }
      }
    }
  }
}
