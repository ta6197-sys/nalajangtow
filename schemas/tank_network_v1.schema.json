{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docktimize isolated tank network V1",
  "description": "Structural schema only; src/daily_planning/tank/network.py enforces numeric inventory and topology invariants.",
  "type": "object",
  "required": [
    "schema_version",
    "data_origin",
    "required_tank_count",
    "required_total_capacity_bbl",
    "tanks",
    "connections"
  ],
  "properties": {
    "schema_version": {
      "const": "TANK_NETWORK_V1"
    },
    "data_origin": {
      "enum": [
        "SYNTHETIC_FIXTURE",
        "SOURCE_VERIFIED"
      ]
    },
    "source_reference": {
      "type": "string",
      "minLength": 1
    },
    "operational_approval": {
      "type": "boolean"
    },
    "required_tank_count": {
      "const": 30
    },
    "required_total_capacity_bbl": {
      "const": "10000000"
    },
    "notes": {
      "type": "string"
    },
    "tanks": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "tank_id",
          "cargo_type",
          "capacity_bbl",
          "initial_stock_bbl",
          "min_operating_bbl",
          "max_operating_bbl",
          "fixed_process_net_flow_bbl_per_hour"
        ],
        "properties": {
          "tank_id": {
            "type": "string",
            "minLength": 1
          },
          "cargo_type": {
            "type": "string",
            "minLength": 1
          },
          "capacity_bbl": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "initial_stock_bbl": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "min_operating_bbl": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "max_operating_bbl": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "fixed_process_net_flow_bbl_per_hour": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "berth_id",
          "tank_id",
          "max_transfer_rate_bbl_per_hour"
        ],
        "properties": {
          "berth_id": {
            "type": "string",
            "minLength": 1
          },
          "tank_id": {
            "type": "string",
            "minLength": 1
          },
          "max_transfer_rate_bbl_per_hour": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          }
        }
      }
    }
  }
}
